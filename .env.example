# ============================================================================
# AYNE EXCHANGE — Environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Database (MySQL / MariaDB) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://ayne:changeme@localhost:3306/ayne_exchange"

# --- App ---
# Public base URL (used for canonical URLs, sitemap, OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth / sessions ---
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret-min-32-chars"
# Session lifetime in seconds (default 8h).
SESSION_TTL_SECONDS="28800"

# --- Contact channels (surfaced in UI; also editable in admin settings) ---
NEXT_PUBLIC_WHATSAPP_NUMBER="+10000000000"
NEXT_PUBLIC_TELEGRAM_USERNAME="ayneexchange"
CONTACT_EMAIL="contact@example.com"

# --- Exchange rate providers (optional; app works with manual rates without these) ---
# The rate layer is provider-agnostic. Configure whichever you use.
RATES_PROVIDER="manual"          # manual | exchangerate-host | openexchangerates
OPENEXCHANGERATES_APP_ID=""
EXCHANGERATE_HOST_API_KEY=""
# Optional separate provider for Iran market rates (official/NIMA/market differ).
IRAN_RATES_PROVIDER=""
IRAN_RATES_API_KEY=""

# --- Rate refresh cron (protects the /api/cron/rates endpoint) ---
CRON_SECRET="replace-with-a-random-cron-secret"
